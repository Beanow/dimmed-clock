{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Dimmed Clock",
	"version": "0.1.0",
	"identifier": "io.github.beanow.dimmed-clock",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "Dimmed Clock",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false,
				"backgroundColor": "#111111"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "rpm", "appimage"],
		"category": "Utility",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "REPLACE_WITH_UPDATER_PUBKEY",
			"endpoints": [
				"https://cdn.crabnebula.app/update/beanow/dimmed-clock/{{target}}-{{arch}}/{{current_version}}"
			]
		}
	}
}
